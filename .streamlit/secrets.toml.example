# ==========================================
# 📊 Google Sheets 연동 설정 예시 (secrets.toml)
# ==========================================
# Streamlit Community Cloud의 [Settings] -> [Secrets] 에 아래 내용을 등록하면
# 점검 일지 데이터가 구글 스프레드시트와 실시간으로 영구 동기화됩니다.

[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/여러분의_스프레드시트_ID/edit"

# (선택 사항) 비공개 시트 또는 서비스 계정 인증이 필요한 경우:
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "..."
# client_email = "..."
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."

